# .env.example
# 方針：値は入れない（キー名だけ）。本番値はデプロイ先の環境変数で管理する。
# 注意：このファイルはコミットOK。実際の .env はコミットしない。

# 予約（外部サイト）
NEXT_PUBLIC_BOOKING_URL=

# 地図（埋め込み/外部リンク）
NEXT_PUBLIC_MAP_URL=

# 問い合わせ（外部：公式LINE）
NEXT_PUBLIC_LINE_URL=

# サイトの正規URL（OGP/SEOで参照する場合）
NEXT_PUBLIC_SITE_URL=

# アクセス解析（導入する場合のみ）
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
